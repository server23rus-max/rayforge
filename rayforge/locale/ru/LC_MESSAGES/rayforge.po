msgstr ""
"Не удалось подключиться к OctoPrint по адресу «{host}:{port}». Проверьте "
"адрес и сетевое соединение."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Authentication Failed"
msgstr "Ошибка авторизации"

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid ""
"The API key is invalid or has expired. Please re-authenticate in device "
"settings."
msgstr ""
"Ключ API недействителен или просрочен. Повторите авторизацию в настройках "
"устройства."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "OctoPrint returned no login data."
msgstr "OctoPrint не вернул данные авторизации."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Unexpected WebSocket frame."
msgstr "Неожиданный WebSocket-фрейм."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Server closed WebSocket connection."
msgstr "Сервер закрыл WebSocket-соединение."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Print Failed"
msgstr "Печать не удалась"

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid ""
"OctoPrint reported that the print job failed. Check OctoPrint for details."
msgstr ""
"OctoPrint сообщил об ошибке задания печати. Подробности см. в OctoPrint."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Driver not configured with a host."
msgstr "В драйвере не указан хост."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Authentication failed during upload."
msgstr "Ошибка авторизации при загрузке."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid "Printer is busy or not operational. Cannot start a new job."
msgstr ""
"Принтер занят или не готов к работе. Невозможно запустить новое задание."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid ""
"OctoPrint accepted the file but could not start printing. The printer may "
"not be operational or is already busy."
msgstr ""
"OctoPrint принял файл, но не смог начать печать. Возможно, принтер не готов "
"к работе или уже занят."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
#, python-brace-format
msgid "Could not upload file to OctoPrint at '{host}:{port}'."
msgstr "Не удалось загрузить файл в OctoPrint по адресу «{host}:{port}»."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid ""
"OctoPrint does not support writing device firmware settings through its API."
msgstr ""
"OctoPrint не поддерживает запись настроек прошивки устройства через свой "
"API."

#: rayforge/machine/driver/octoprint/octoprint_driver.py
msgid ""
"Probe command sent. OctoPrint does not report probe results via its API."
msgstr ""
"Команда зондирования отправлена. OctoPrint не сообщает результаты "
"зондирования через свой API."

#: rayforge/machine/driver/marlin/marlin_serial.py
msgid "Marlin (Serial)"
msgstr "Marlin (последовательный порт)"

#: rayforge/machine/driver/marlin/marlin_serial.py
msgid "Marlin firmware via serial connection"
msgstr "Прошивка Marlin через последовательное соединение"

#: rayforge/machine/driver/marlin/marlin_serial.py
msgid "Marlin device"
msgstr "Устройство Marlin"

#: rayforge/machine/driver/marlin/marlin_serial.py
#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "Serial port or USB VID:PID (e.g. 0403:6001)"
msgstr "Последовательный порт или USB VID:PID (например, 0403:6001)"

#: rayforge/machine/driver/marlin/marlin_serial.py
#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "Port must be configured."
msgstr "Необходимо указать порт."

#: rayforge/machine/driver/marlin/marlin_serial.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Baud rate must be configured."
msgstr "Необходимо указать скорость передачи (бод)."

#: rayforge/machine/driver/marlin/marlin_serial.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Port not configured"
msgstr "Порт не настроен"

#: rayforge/machine/driver/marlin/marlin_serial.py
msgid "No response from device"
msgstr "Нет ответа от устройства"

#: rayforge/machine/driver/grbl/grbl_telnet.py
msgid "GRBL (Telnet)"
msgstr "GRBL (Telnet)"

#: rayforge/machine/driver/grbl/grbl_telnet.py
msgid "GRBL-compatible controller over a raw TCP/telnet connection"
msgstr "GRBL-совместимый контроллер через прямое TCP/telnet-соединение"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_network.py
#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "The IP address or hostname of the device"
msgstr "IP-адрес или имя хоста устройства"

#: rayforge/machine/driver/grbl/grbl_telnet.py
msgid "TCP port for the raw/telnet service"
msgstr "TCP-порт для прямого/telnet-сервиса"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Poll device status during jobs"
msgstr "Опрашивать состояние устройства во время заданий"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid ""
"Periodically query the device for position and status while a job is "
"running. Warning: Some devices have trouble maintaining a stable connection "
"if this is used!"
msgstr ""
"Периодически запрашивать у устройства позицию и статус во время выполнения "
"задания. Внимание: у некоторых устройств при этом могут возникать проблемы "
"со стабильностью соединения!"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Deadlock detection"
msgstr "Обнаружение взаимной блокировки"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid ""
"Detect and recover from serial communication deadlocks during jobs. If "
"disabled, the driver will simply wait for the machine to respond. Disable if"
" you experience false ALARM:3 errors."
msgstr ""
"Обнаруживает и устраняет взаимные блокировки последовательного соединения во"
" время заданий. Если выключено, драйвер просто будет ждать ответа станка. "
"Отключите, если возникают ложные ошибки ALARM:3."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Command Letter"
msgstr "Отсутствует буква команды"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G-code commands need a letter followed by a value. The command letter was "
"not found."
msgstr ""
"Команды G-code требуют букву, за которой следует значение. Буква команды не "
"найдена."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Number Format"
msgstr "Неверный формат числа"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The value is missing or not in the correct numeric format. Check your G-code"
" syntax."
msgstr ""
"Значение отсутствует или имеет неверный числовой формат. Проверьте синтаксис"
" G-code."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Command"
msgstr "Неизвестная команда"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This Grbl setting command is not recognized or supported. Check the command "
"syntax."
msgstr ""
"Эта команда настройки Grbl не распознана или не поддерживается. Проверьте "
"синтаксис команды."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Negative Value"
msgstr "Отрицательное значение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "A positive number is required here, but a negative value was received."
msgstr ""
"Здесь требуется положительное число, но получено отрицательное значение."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Disabled"
msgstr "Базирование отключено"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing is not enabled in settings. Enable homing ($22=1) to use this "
"feature."
msgstr ""
"Базирование не включено в настройках. Включите базирование ($22=1), чтобы "
"использовать эту функцию."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Pulse Time Too Short"
msgstr "Слишком короткая длительность импульса"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Minimum step pulse time must be greater than 3 microseconds. Check setting "
"$0."
msgstr ""
"Минимальная длительность импульса шага должна быть больше 3 микросекунд. "
"Проверьте настройку $0."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Memory Error"
msgstr "Ошибка памяти"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Settings reset to defaults due to a memory read failure. Reconfigure your "
"settings if needed."
msgstr ""
"Настройки сброшены до значений по умолчанию из-за ошибки чтения памяти. При "
"необходимости настройте параметры заново."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Machine Busy"
msgstr "Станок занят"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This command can only be used when the machine is idle. Wait for the current"
" job to finish."
msgstr ""
"Эту команду можно использовать только когда станок простаивает. Дождитесь "
"завершения текущего задания."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Commands Locked"
msgstr "Команды заблокированы"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Cannot send commands while in alarm or jog mode. Clear the alarm state "
"first."
msgstr ""
"Невозможно отправлять команды в режиме аварии или джога. Сначала сбросьте "
"состояние аварии."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Required"
msgstr "Требуется базирование"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Soft limits cannot be enabled without homing also enabled. Enable homing "
"first ($22=1)."
msgstr ""
"Программные ограничения нельзя включить без включённого базирования. Сначала"
" включите базирование ($22=1)."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Too Long"
msgstr "Строка слишком длинная"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The command line has too many characters and was ignored. Check your file "
"formatting."
msgstr ""
"Строка команды содержит слишком много символов и была проигнорирована. "
"Проверьте формат файла."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Setting Too High"
msgstr "Значение настройки слишком велико"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This setting exceeds the maximum step rate supported. Use a lower value."
msgstr ""
"Эта настройка превышает максимально поддерживаемую частоту шагов. "
"Используйте меньшее значение."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Door Open"
msgstr "Дверь открыта"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The safety door was detected as open. Close the door and resume operation."
msgstr ""
"Обнаружена открытая защитная дверь. Закройте дверь и продолжите работу."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Build info or startup line exceeds storage limit. Shorten the line."
msgstr ""
"Информация о сборке или строка запуска превышает предел хранилища. Сократите"
" строку."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Target Out of Range"
msgstr "Цель вне диапазона"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Jog target is beyond the machine's travel limits. Move to a position within "
"range."
msgstr ""
"Цель перемещения джогом находится за пределами рабочей зоны станка. "
"Переместитесь в пределы допустимого диапазона."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Jog Command"
msgstr "Неверная команда джога"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Jog command is missing '=' or contains prohibited G-code. Check the jog "
"syntax."
msgstr ""
"В команде джога отсутствует «=» или содержится запрещённый G-code. Проверьте"
" синтаксис команды джога."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Laser Mode Error"
msgstr "Ошибка режима лазера"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Laser mode requires PWM output to work. Check your hardware configuration."
msgstr ""
"Для работы режима лазера требуется выход ШИМ. Проверьте конфигурацию "
"оборудования."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Not Running"
msgstr "Шпиндель не запущен"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"A motion command was issued but the spindle is not running. Start the "
"spindle before motion."
msgstr ""
"Отправлена команда перемещения, но шпиндель не запущен. Запустите шпиндель "
"перед перемещением."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Speed Mismatch"
msgstr "Несоответствие скорости шпинделя"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The current spindle speed does not match the speed required by the command. "
"Wait for the spindle to reach the target speed."
msgstr ""
"Текущая скорость шпинделя не соответствует требуемой командой. Дождитесь, "
"пока шпиндель достигнет заданной скорости."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Command"
msgstr "Неподдерживаемая команда"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This G-code command is not supported by the machine. Check your post-"
"processor settings."
msgstr ""
"Эта команда G-code не поддерживается станком. Проверьте настройки "
"постпроцессора."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Conflicting Commands"
msgstr "Конфликтующие команды"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Multiple commands from the same group found on one line. Remove the "
"duplicate command."
msgstr ""
"В одной строке найдено несколько команд из одной группы. Удалите "
"повторяющуюся команду."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Feed Rate Missing"
msgstr "Не задана скорость подачи"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Set a feed rate before using motion commands. Add an F command to specify "
"speed."
msgstr ""
"Задайте скорость подачи перед использованием команд перемещения. Добавьте "
"команду F, чтобы указать скорость."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Integer Required"
msgstr "Требуется целое число"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a whole number value. Remove any decimal points."
msgstr "Эта команда требует целочисленное значение. Удалите десятичные точки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Conflict"
msgstr "Конфликт осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Multiple commands trying to use the same axis. Simplify the command."
msgstr ""
"Несколько команд пытаются использовать одну и ту же ось. Упростите команду."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Duplicate Word"
msgstr "Повторяющееся слово"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The same G-code word appears more than once. Remove the duplicate."
msgstr ""
"Одно и то же слово G-code встречается более одного раза. Удалите повторение."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Axis"
msgstr "Отсутствует ось"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This command requires XYZ axis coordinates. Add the missing axis values."
msgstr ""
"Эта команда требует координаты осей XYZ. Добавьте недостающие значения осей."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Number Out of Range"
msgstr "Номер строки вне диапазона"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line number must be between 1 and 9,999,999. Use a valid line number."
msgstr ""
"Номер строки должен быть от 1 до 9 999 999. Используйте допустимый номер "
"строки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Value"
msgstr "Отсутствует значение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a P or L value. Add the missing parameter."
msgstr "Эта команда требует значение P или L. Добавьте недостающий параметр."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Coordinate"
msgstr "Неподдерживаемая система координат"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Only G54-G59 coordinate systems are supported. Use one of these instead."
msgstr ""
"Поддерживаются только системы координат G54–G59. Используйте одну из них."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Motion Mode"
msgstr "Неверный режим перемещения"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G53 command requires G0 or G1 motion mode. Set the correct motion mode "
"first."
msgstr ""
"Команда G53 требует режим перемещения G0 или G1. Сначала задайте корректный "
"режим перемещения."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Axis Words"
msgstr "Неиспользуемые слова осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Axis words present but G80 cancel is active. Remove the unused axis words."
msgstr ""
"Присутствуют слова осей, но активна отмена G80. Удалите неиспользуемые слова"
" осей."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Data"
msgstr "Отсутствуют данные дуги"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G2/G3 arc command needs XYZ coordinates. Add the axis values for the "
"selected plane."
msgstr ""
"Команда дуги G2/G3 требует координаты XYZ. Добавьте значения осей для "
"выбранной плоскости."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Target"
msgstr "Недопустимая цель"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Cannot create this arc or probe to current position. Check the target "
"coordinates."
msgstr ""
"Невозможно построить эту дугу или выполнить зондирование в текущую позицию. "
"Проверьте координаты цели."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Arc Geometry Error"
msgstr "Ошибка геометрии дуги"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Arc calculation failed. Try breaking the arc into smaller pieces or use IJK "
"offset instead."
msgstr ""
"Не удалось вычислить дугу. Попробуйте разбить дугу на меньшие участки или "
"использовать смещение IJK."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Offset"
msgstr "Отсутствует смещение дуги"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G2/G3 arc command needs IJK offset values. Add the missing offset for the "
"selected plane."
msgstr ""
"Команда дуги G2/G3 требует значения смещения IJK. Добавьте недостающее "
"смещение для выбранной плоскости."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Words"
msgstr "Неиспользуемые слова"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Some G-code words in this line are not used by any command. Remove the "
"unused words."
msgstr ""
"Некоторые слова G-code в этой строке не используются ни одной командой. "
"Удалите неиспользуемые слова."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Axis for Offset"
msgstr "Неверная ось для смещения"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Tool length offset only works on the configured axis (usually Z-axis). Check"
" your settings."
msgstr ""
"Смещение длины инструмента работает только на настроенной оси (обычно это "
"ось Z). Проверьте настройки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Tool Number Too High"
msgstr "Слишком большой номер инструмента"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Tool number exceeds the maximum supported value. Use a valid tool number."
msgstr ""
"Номер инструмента превышает максимально поддерживаемое значение. Используйте"
" допустимый номер инструмента."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Hard Limit"
msgstr "Аппаратный концевик"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"A hard limit switch was triggered. The machine has stopped and needs to be "
"reset. Check for obstructions and verify your limit switches."
msgstr ""
"Сработал аппаратный концевой выключатель. Станок остановлен и требует "
"сброса. Проверьте отсутствие препятствий и исправность концевых "
"выключателей."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Soft Limit"
msgstr "Программное ограничение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine would move beyond its configured travel limits. Check that your "
"work area and coordinate offsets are correct."
msgstr ""
"Станок вышел бы за пределы настроенной рабочей зоны. Проверьте правильность "
"рабочей области и смещений координат."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Abort Cycle"
msgstr "Прерывание цикла"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The currently running job was cancelled while in motion. Reset the machine "
"to continue."
msgstr ""
"Выполняемое задание было отменено во время перемещения. Сбросьте станок, "
"чтобы продолжить."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Initial"
msgstr "Ошибка зондирования — начало"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The probe did not make contact before the maximum travel distance was "
"reached. Check the probe wiring and positioning."
msgstr ""
"Щуп не коснулся поверхности до достижения максимального расстояния "
"перемещения. Проверьте проводку и положение щупа."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Final"
msgstr "Ошибка зондирования — завершение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The probe failed to retract to the target position after contact. Check the "
"probe configuration."
msgstr ""
"Щуп не смог вернуться в целевую позицию после касания. Проверьте настройки "
"щупа."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Reset"
msgstr "Ошибка базирования — сброс"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing was not able to complete because the machine is in an alarm state. "
"Clear the alarm and try again."
msgstr ""
"Базирование не завершено, так как станок находится в состоянии аварии. "
"Сбросьте аварию и повторите попытку."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Approach"
msgstr "Ошибка базирования — подход"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The homing cycle failed to find the switch within the configured travel "
"distance. Check your switch wiring and pull-off settings."
msgstr ""
"Циклу базирования не удалось найти выключатель в пределах настроенного "
"расстояния перемещения. Проверьте проводку выключателя и настройки отвода."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Pulloff"
msgstr "Ошибка базирования — отвод"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The homing cycle failed to successfully pull off the switch after contact. "
"Increase the pull-off distance or check the switch."
msgstr ""
"Циклу базирования не удалось отвести от выключателя после касания. Увеличьте"
" расстояние отвода или проверьте выключатель."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Home Without Limits"
msgstr "Базирование без концевиков"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing was commanded but limit switches are not configured. Enable limit "
"switches first."
msgstr ""
"Запрошено базирование, но концевые выключатели не настроены. Сначала "
"включите концевые выключатели."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Dual Axis"
msgstr "Ошибка базирования — парная ось"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing failed on a dual-axis configuration. One or both axes did not reach "
"their limit switches. Check your limit switch wiring and configuration."
msgstr ""
"Ошибка базирования при конфигурации с парной осью. Одна или обе оси не "
"достигли своих концевых выключателей. Проверьте проводку и настройки "
"концевых выключателей."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Alarm"
msgstr "Неизвестная авария"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid alarm code reported by machine."
msgstr "Станок сообщил недопустимый код аварии."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine reported an unrecognized alarm code. Check your machine and "
"firmware documentation."
msgstr ""
"Станок сообщил нераспознанный код аварии. Проверьте документацию станка и "
"прошивки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Error"
msgstr "Неизвестная ошибка"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid error code reported by machine."
msgstr "Станок сообщил недопустимый код ошибки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine reported an unrecognized error code. Check your machine and "
"firmware documentation."
msgstr ""
"Станок сообщил нераспознанный код ошибки. Проверьте документацию станка и "
"прошивки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Stepper Configuration"
msgstr "Настройка шаговых двигателей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings related to stepper motor timing and signal polarity."
msgstr "Настройки синхронизации шаговых двигателей и полярности сигналов."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Control & Reporting"
msgstr "Управление и отчётность"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings for GRBL's motion control and status reporting."
msgstr "Настройки управления перемещением и отчётности о состоянии GRBL."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Limits & Homing"
msgstr "Ограничения и базирование"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings for soft/hard limits and the homing cycle."
msgstr "Настройки программных/аппаратных ограничений и цикла базирования."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle & Laser"
msgstr "Шпиндель и лазер"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings for controlling the spindle or laser module."
msgstr "Настройки управления шпинделем или лазерным модулем."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Calibration"
msgstr "Калибровка осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Defines the steps-per-millimeter for each axis."
msgstr "Задаёт количество шагов на миллиметр для каждой оси."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Kinematics"
msgstr "Кинематика осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Defines the maximum rate and acceleration for each axis."
msgstr "Задаёт максимальную скорость и ускорение для каждой оси."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Travel"
msgstr "Ход осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Defines the maximum travel distance for each axis."
msgstr "Задаёт максимальное расстояние перемещения для каждой оси."

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "GRBL (Serial)"
msgstr "GRBL (последовательный порт)"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "GRBL-compatible serial connection"
msgstr "GRBL-совместимое последовательное соединение"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "GRBL device"
msgstr "Устройство GRBL"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Driver is not set up. Check the port settings."
msgstr "Драйвер не настроен. Проверьте настройки порта."

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "RX Buffer Size Override"
msgstr "Переопределение размера буфера приёма"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid ""
"Force a specific RX buffer size in bytes. Set to 0 to auto-detect from the "
"device."
msgstr ""
"Принудительно задать размер буфера приёма в байтах. Установите 0 для "
"автоопределения по устройству."

#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Unknown Settings"
msgstr "Неизвестные настройки"

#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Settings reported by the device not in the standard list."
msgstr ""
"Настройки, сообщённые устройством и отсутствующие в стандартном списке."

#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Unknown setting from device"
msgstr "Неизвестная настройка от устройства"

#: rayforge/machine/driver/grbl/grbl_probe.py
msgid ""
"Device is configured to report in inches ($13=1). All values shown are in "
"machine units."
msgstr ""
"Устройство настроено сообщать значения в дюймах ($13=1). Все отображаемые "
"значения указаны в единицах станка."

#: rayforge/machine/driver/grbl/grbl_probe.py
msgid ""
"Laser mode is not enabled ($32=0). Enable it for best results with laser "
"cutters."
msgstr ""
"Режим лазера не включён ($32=0). Включите его для лучших результатов с "
"лазерными станками."

#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "GRBL (Serial Simple)"
msgstr "GRBL (простой последовательный)"

#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "GRBL serial with simple ping-pong protocol (no buffer counting)"
msgstr ""
"Последовательное соединение GRBL с простым протоколом ping-pong (без "
"подсчёта буфера)"

#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "Baudrate must be configured."
msgstr "Необходимо указать скорость передачи (бод)."

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "GRBL (Network)"
msgstr "GRBL (сеть)"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Connect to a GRBL-compatible device over the network"
msgstr "Подключение к GRBL-совместимому устройству по сети"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "HTTP Port"
msgstr "HTTP-порт"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "The HTTP port for the device"
msgstr "HTTP-порт устройства"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "WebSocket Port"
msgstr "WebSocket-порт"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid ""
"The WebSocket port for the device. For FluidNC, use the same port as HTTP "
"(usually 80)."
msgstr ""
"WebSocket-порт устройства. Для FluidNC используйте тот же порт, что и для "
"HTTP (обычно 80)."

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Protocol variant"
msgstr "Вариант протокола"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Standard, ESP3D, Longer, or FluidNC variant"
msgstr "Вариант Standard, ESP3D, Longer или FluidNC"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Standard"
msgstr "Стандартный"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Host is not configured. Please set a valid IP address or hostname."
msgstr "Хост не настроен. Укажите корректный IP-адрес или имя хоста."

#: rayforge/machine/driver/grbl/grbl_network.py
#, python-brace-format
msgid ""
"Could not connect to host '{host}'. Check the IP address and network "
"connection."
msgstr ""
"Не удалось подключиться к хосту «{host}». Проверьте IP-адрес и сетевое "
"соединение."

#: rayforge/machine/driver/smoothie/smoothie_util.py
#, python-brace-format
msgid ""
"Smoothie reported a non-positive work-area dimension (alpha_max={x}, "
"beta_max={y})."
msgstr ""
"Smoothie сообщил неположительный размер рабочей области (alpha_max={x}, "
"beta_max={y})."

#: rayforge/machine/driver/smoothie/smoothie_util.py
msgid "Could not read the Smoothie work-area dimensions."
msgstr "Не удалось получить размеры рабочей области Smoothie."

#: rayforge/machine/driver/smoothie/smoothie_util.py
msgid "Could not read the Smoothie maximum feed rates."
msgstr "Не удалось получить максимальные скорости подачи Smoothie."

#: rayforge/machine/driver/smoothie/smoothie_util.py
msgid "Could not read the Smoothie acceleration."
msgstr "Не удалось получить ускорение Smoothie."

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "Smoothie"
msgstr "Smoothie"

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "Smoothieware via a Telnet connection"
msgstr "Smoothieware через Telnet-соединение"

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "The Telnet port number"
msgstr "Номер Telnet-порта"

#: rayforge/machine/discovery/mdns_channel.py
#, python-brace-format
msgid "{host}:{port}"
msgstr "{host}:{port}"

#: rayforge/machine/discovery/serial_channel.py
#, python-brace-format
msgid "{port} at {baud} baud"
msgstr "{port} на {baud} бод"

#: rayforge/machine/sanity/result.py rayforge/machine/models/zone.py
msgid "No-Go Zone"
msgstr "Запретная зона"

#: rayforge/machine/sanity/result.py
msgid "Outside Work Area"
msgstr "Вне рабочей области"

#: rayforge/machine/sanity/result.py
msgid "Machine Extent"
msgstr "Габариты станка"

#: rayforge/machine/device/profile.py
#: rayforge/ui_gtk/machine/gcode_settings_page.py
#: rayforge/ui_gtk/machine/settings_dialog.py
msgid "G-code"
msgstr "G-code"

#: rayforge/machine/device/profile.py
