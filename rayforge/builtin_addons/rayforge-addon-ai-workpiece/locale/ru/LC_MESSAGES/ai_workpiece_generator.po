#: ai_workpiece_generator/widgets/dialog.py
msgid "Generate a Workpiece"
msgstr "Создать заготовку"

#: ai_workpiece_generator/widgets/dialog.py
msgid "Cancel"
msgstr "Отмена"

#: ai_workpiece_generator/widgets/dialog.py
msgid "Generate"
msgstr "Создать"

#: ai_workpiece_generator/widgets/dialog.py
msgid ""
"Describe the design you want to create. Example: 'A simple star shape with 5"
" points'"
msgstr "Опишите нужный дизайн. Например: «Простая пятиконечная звезда»"

#: ai_workpiece_generator/widgets/dialog.py
msgid "No content generated."
msgstr "Контент не сгенерирован."

#: ai_workpiece_generator/widgets/dialog.py
msgid "Add AI-Generated Workpiece"
msgstr "Добавить заготовку, созданную ИИ"

#: ai_workpiece_generator/widgets/dialog.py
msgid "Close"
msgstr "Закрыть"

#: ai_workpiece_generator/frontend.py
msgid "Generate Workpiece with AI..."
msgstr "Создать заготовку с помощью ИИ…"

#: ai_workpiece_generator/generator.py
msgid ""
"No AI provider configured. Please configure an AI provider in Settings."
msgstr ""
"Провайдер ИИ не настроен. Настройте провайдера ИИ в разделе «Настройки»."

#: ai_workpiece_generator/generator.py
msgid "No response from AI provider."
msgstr "Нет ответа от провайдера ИИ."

#: ai_workpiece_generator/generator.py
msgid "AI did not generate valid SVG code. Please try a different prompt."
msgstr "ИИ не сгенерировал корректный код SVG. Попробуйте другой запрос."
