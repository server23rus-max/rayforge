#: laser_essentials/material_test_helpers.py
msgid "Cut"
msgstr "Резка"

#: laser_essentials/material_test_helpers.py
#: laser_essentials/widgets/raster_page.py
#: laser_essentials/steps/raster_step.py
msgid "Engrave"
msgstr "Гравировка"

#: laser_essentials/material_test_helpers.py
msgid "Power vs Speed"
msgstr "Мощность/Скорость"

#: laser_essentials/material_test_helpers.py
msgid "Power vs Passes"
msgstr "Мощность/Проходы"

#: laser_essentials/material_test_helpers.py
msgid "Speed vs Passes"
msgstr "Скорость/Проходы"

#: laser_essentials/material_test_helpers.py
msgid "Speed vs Offset"
msgstr "Скорость/Смещение"

#: laser_essentials/material_test_helpers.py
msgid "Columns (Power Steps)"
msgstr "Столбцы (шаги мощности)"

#: laser_essentials/material_test_helpers.py
msgid "Rows (Speed Steps)"
msgstr "Строки (шаги скорости)"

#: laser_essentials/material_test_helpers.py
#: laser_essentials/steps/material_test.py
msgid "Number of power variations"
msgstr "Количество вариантов мощности"

#: laser_essentials/material_test_helpers.py
#: laser_essentials/steps/material_test.py
msgid "Number of speed variations"
msgstr "Количество вариантов скорости"

#: laser_essentials/material_test_helpers.py
msgid "Rows (Passes Steps)"
msgstr "Строки (шаги проходов)"

#: laser_essentials/material_test_helpers.py
msgid "Number of passes variations"
msgstr "Количество вариантов проходов"

#: laser_essentials/material_test_helpers.py
msgid "Columns (Speed Steps)"
msgstr "Столбцы (шаги скорости)"

#: laser_essentials/material_test_helpers.py
msgid "Rows (Offset Steps)"
msgstr "Строки (шаги смещения)"

#: laser_essentials/material_test_helpers.py
msgid "Number of offset variations"
msgstr "Количество вариантов смещения"

#: laser_essentials/widgets/shrinkwrap_page.py
#: laser_essentials/steps/shrinkwrap_step.py
msgid "Shrink Wrap"
msgstr "Облегающий контур"

#: laser_essentials/widgets/shrinkwrap_page.py
msgid "Fit a hull around the content and trace it."
msgstr "Строит облегающий контур вокруг содержимого и обводит его."

#: laser_essentials/widgets/wavefront_page.py
#: laser_essentials/steps/wavefront_step.py
msgid "Wavefront"
msgstr "Волновой фронт"

#: laser_essentials/widgets/wavefront_page.py
msgid "Clear pockets with a wavefront toolpath."
msgstr "Очищает карманы траекторией волнового фронта."

#: laser_essentials/widgets/laser_step_page.py
msgid "Cut Speed"
msgstr "Скорость резки"

#: laser_essentials/widgets/laser_step_page.py
#: laser_essentials/steps/laser_step.py
msgid "Laser power, speed, and head selection for this operation."
msgstr "Мощность лазера, скорость и выбор головки для этой операции."

#: laser_essentials/widgets/laser_step_page.py
msgid "Settings provided by the machine's hardware for this head."
msgstr "Настройки, предоставляемые аппаратной частью станка для этой головки."

#: laser_essentials/widgets/laser_step_page.py
#: laser_essentials/steps/laser_step.py
msgid "Laser"
msgstr "Лазер"

#: laser_essentials/widgets/laser_step_page.py
msgid "Machine"
msgstr "Станок"

#: laser_essentials/widgets/laser_step_page.py
msgid "Change Head"
msgstr "Изменить головку"

#: laser_essentials/widgets/contour_page.py
msgid "Contour Settings"
msgstr "Настройки контура"

#: laser_essentials/widgets/contour_page.py
msgid "Trace the outline of the selected shapes."
msgstr "Обводит контур выбранных фигур."

#: laser_essentials/widgets/frame_page.py
msgid "Geometry"
msgstr "Геометрия"

#: laser_essentials/widgets/frame_page.py
msgid "Cut a frame around the selected content."
msgstr "Вырезает рамку вокруг выбранного содержимого."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Grid"
msgstr "Сетка"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Test cell dimensions, shape, and spacing."
msgstr "Размеры, форма и интервалы тестовых ячеек."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Labels"
msgstr "Подписи"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Speed/power annotations on the grid."
msgstr "Подписи скорости/мощности на сетке."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Parameters"
msgstr "Параметры"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Define the parameter ranges for the test grid."
msgstr "Задаёт диапазоны параметров для тестовой сетки."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Diode Engrave"
msgstr "Гравировка диодным лазером"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Diode Cut"
msgstr "Резка диодным лазером"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "CO2 Engrave"
msgstr "Гравировка CO2-лазером"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "CO2 Cut"
msgstr "Резка CO2-лазером"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Select"
msgstr "Выбрать"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Preset"
msgstr "Предустановка"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Load common test configurations."
msgstr "Загружает типовые конфигурации теста."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Presets"
msgstr "Предустановки"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Load common test configurations"
msgstr "Загрузка типовых конфигураций теста"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Min Power (White)"
msgstr "Мин. мощность (белый)"

#: laser_essentials/widgets/raster_power_widget.py
#: laser_essentials/steps/raster_step.py
msgid "Power for lightest areas, as a percentage of the step's main power"
msgstr ""
"Мощность для самых светлых участков, в процентах от основной мощности этапа"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Max Power (Black)"
msgstr "Макс. мощность (чёрный)"

#: laser_essentials/widgets/raster_power_widget.py
#: laser_essentials/steps/raster_step.py
msgid "Power for darkest areas, as a percentage of the step's main power"
msgstr ""
"Мощность для самых тёмных участков, в процентах от основной мощности этапа"

#: laser_essentials/widgets/raster_page.py
msgid "Engrave Speed"
msgstr "Скорость гравировки"

#: laser_essentials/widgets/raster_page.py
msgid "Raster the image onto the material."
msgstr "Растеризует изображение на материале."

#: laser_essentials/widgets/raster_page.py
#: laser_essentials/steps/laser_step.py
msgid "Power"
msgstr "Мощность"

#: laser_essentials/widgets/raster_page.py
msgid "Power modulation and brightness range."
msgstr "Модуляция мощности и диапазон яркости."

#: laser_essentials/widgets/raster_page.py
msgid "Change Power Range"
msgstr "Изменить диапазон мощности"

#: laser_essentials/widgets/offset_fill_page.py
#: laser_essentials/steps/offset_fill_step.py
msgid "Offset Fill"
msgstr "Заливка смещением"

#: laser_essentials/widgets/offset_fill_page.py
msgid "Fill closed shapes with rings that follow the outline."
msgstr "Заполняет замкнутые фигуры кольцами, повторяющими контур."

#: laser_essentials/widgets/levels_adapter.py
msgid "Auto-adjusted based on image content"
msgstr "Автоматически подстраивается по содержимому изображения"

#: laser_essentials/widgets/levels_adapter.py
msgid "Drag markers to set black/white points"
msgstr "Перетащите маркеры, чтобы задать точки чёрного/белого"

#: laser_essentials/steps/laser_step.py
msgid ""
"Laser head used for this step; the machine's first head is used when unset"
msgstr ""
"Лазерная головка, используемая для этого этапа; если не задана, используется"
" первая головка станка"

#: laser_essentials/steps/laser_step.py
msgid "Laser power as a percentage"
msgstr "Мощность лазера в процентах"

#: laser_essentials/steps/laser_step.py
msgid "Power Mode"
msgstr "Режим мощности"

#: laser_essentials/steps/laser_step.py
msgid ""
"Dynamic power (M4) scales power with head speed; constant power (M3) keeps "
"it fixed. Use constant power if corners and curves burn too lightly"
msgstr ""
"Динамическая мощность (M4) масштабируется со скоростью головки; постоянная "
"мощность (M3) остаётся неизменной. Используйте постоянную мощность, если "
"углы и кривые прожигаются слишком слабо"

#: laser_essentials/steps/laser_step.py
msgid "Dynamic (M4)"
msgstr "Динамическая (M4)"

#: laser_essentials/steps/laser_step.py
msgid "Constant (M3)"
msgstr "Постоянная (M3)"

#: laser_essentials/steps/laser_step.py
msgid "Air Assist"
msgstr "Обдув"

#: laser_essentials/steps/laser_step.py
msgid "Blow air over the cut to clear debris"
msgstr "Обдувает место резки воздухом для удаления продуктов горения"

#: laser_essentials/steps/laser_step.py
msgid "Tab Power"
msgstr "Мощность перемычек"

#: laser_essentials/steps/laser_step.py
msgid "Laser power at tab positions as a percentage"
msgstr "Мощность лазера в местах перемычек, в процентах"

#: laser_essentials/steps/laser_step.py
msgid "Frequency"
msgstr "Частота"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse frequency in Hz (0 = head default)"
msgstr "Частота импульсов лазера в Гц (0 = значение головки по умолчанию)"

#: laser_essentials/steps/laser_step.py
msgid "Pulse Width"
msgstr "Длительность импульса"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse width in ns (0 = head default)"
msgstr "Длительность импульса лазера в нс (0 = значение головки по умолчанию)"

#: laser_essentials/steps/laser_step.py
msgid "Step Settings"
msgstr "Настройки этапа"

#: laser_essentials/steps/laser_step.py
#, python-brace-format
msgid "{power_percent}% power, {speed_str}"
msgstr "{power_percent}% мощности, {speed_str}"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Gravity"
msgstr "Притяжение"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Pulls the hull inward. 0.0 is a standard convex hull"
msgstr "Стягивает контур внутрь. 0.0 — обычная выпуклая оболочка"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Cut Side"
msgstr "Сторона резки"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/wavefront_step.py
#: laser_essentials/steps/frame_step.py
#: laser_essentials/steps/offset_fill_step.py
#: laser_essentials/steps/contour_step.py
msgid "Offset"
msgstr "Смещение"

#: laser_essentials/steps/shrinkwrap_step.py
msgid ""
"Shifts the contour inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"Смещает контур внутрь/наружу в соответствии со стороной резки (не действует "
"при «По центру линии»). По умолчанию равно компенсации ширины реза для "
"головки"

#: laser_essentials/steps/wavefront_step.py
msgid "Step Over"
msgstr "Шаг между проходами"

#: laser_essentials/steps/wavefront_step.py
msgid "Lateral step-over between wavefront passes"
msgstr "Боковой шаг между проходами волнового фронта"

#: laser_essentials/steps/wavefront_step.py
msgid "Extra offset from walls"
msgstr "Дополнительное смещение от стенок"

#: laser_essentials/steps/frame_step.py
msgid "Frame"
msgstr "Рамка"

#: laser_essentials/steps/frame_step.py
msgid ""
"Shifts the frame inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr ""
"Смещает рамку внутрь/наружу в соответствии со стороной резки (не действует "
"при «По центру линии»). По умолчанию равно компенсации ширины реза для "
"головки"

#: laser_essentials/steps/frame_step.py
msgid "Round Corners"
msgstr "Скруглять углы"

#: laser_essentials/steps/frame_step.py
msgid "Round the frame's corners instead of cutting right angles"
msgstr "Скругляет углы рамки вместо прямых углов"

#: laser_essentials/steps/frame_step.py
msgid "Corner Radius"
msgstr "Радиус скругления"

#: laser_essentials/steps/frame_step.py
msgid "Radius used to round the frame's corners"
msgstr "Радиус, используемый для скругления углов рамки"

#: laser_essentials/steps/offset_fill_step.py
#: laser_essentials/steps/material_test.py
msgid "Line Interval"
msgstr "Шаг линий"

#: laser_essentials/steps/offset_fill_step.py
msgid ""
"Distance between neighbouring fill rings. Defaults to the laser spot size"
msgstr ""
"Расстояние между соседними кольцами заливки. По умолчанию равно размеру "
"пятна лазера"

#: laser_essentials/steps/offset_fill_step.py
msgid "Distance of the first ring inside the outline"
msgstr "Расстояние первого кольца от контура, внутрь"

#: laser_essentials/steps/offset_fill_step.py
msgid "Fill Direction"
msgstr "Направление заливки"

#: laser_essentials/steps/offset_fill_step.py
msgid "Order in which the rings are cut"
msgstr "Порядок, в котором вырезаются кольца"

#: laser_essentials/steps/raster_step.py
msgid "Mode"
msgstr "Режим"

#: laser_essentials/steps/raster_step.py
#: laser_essentials/steps/contour_step.py
msgid "Threshold"
msgstr "Порог"

#: laser_essentials/steps/raster_step.py
msgid "Brightness cutoff for black/white (0-255)"
msgstr "Порог яркости для чёрного/белого (0–255)"

#: laser_essentials/steps/raster_step.py
msgid "Engraving Method"
msgstr "Метод гравировки"

#: laser_essentials/steps/raster_step.py
msgid "Algorithm for converting grayscale to binary"
msgstr "Алгоритм преобразования градаций серого в чёрно-белое изображение"

#: laser_essentials/steps/raster_step.py
msgid "Serpentine"
msgstr "Змейка"

#: laser_essentials/steps/raster_step.py
msgid ""
"Alternate the dither direction on every row to avoid directional artifacts"
msgstr ""
"Чередует направление дизеринга в каждой строке, чтобы избежать направленных "
"артефактов"

#: laser_essentials/steps/raster_step.py
msgid "Halftone Cell Size"
msgstr "Размер ячейки растрирования"

#: laser_essentials/steps/raster_step.py
msgid "Distance between halftone dot centers"
msgstr "Расстояние между центрами точек растрирования"

#: laser_essentials/steps/raster_step.py
msgid "Halftone Angle"
msgstr "Угол растрирования"

#: laser_essentials/steps/raster_step.py
msgid "Rotation of the halftone dot grid"
msgstr "Поворот сетки точек растрирования"

#: laser_essentials/steps/raster_step.py
msgid "Cross-Hatch"
msgstr "Перекрёстная штриховка"

#: laser_essentials/steps/raster_step.py
msgid "Add a second pass at 90 degrees"
msgstr "Добавляет второй проход под углом 90 градусов"

#: laser_essentials/steps/raster_step.py
msgid "Scan Mode"
msgstr "Режим сканирования"

#: laser_essentials/steps/raster_step.py
msgid "Segmented"
msgstr "Сегментированный"

#: laser_essentials/steps/raster_step.py
msgid "Full Sweep"
msgstr "Полный проход"

#: laser_essentials/steps/raster_step.py
msgid ""
"Segmented: moves between content regions. Full Sweep: scans full width with "
"laser toggling"
msgstr ""
"«Сегментированный»: перемещается между областями содержимого. «Полный "
"проход»: сканирует всю ширину с переключением лазера"

#: laser_essentials/steps/raster_step.py
msgid "Line Spacing"
msgstr "Расстояние между строками"

#: laser_essentials/steps/raster_step.py
msgid "Distance between scan lines"
msgstr "Расстояние между строками сканирования"

#: laser_essentials/steps/raster_step.py
msgid "Sample Interval"
msgstr "Интервал выборки"

#: laser_essentials/steps/raster_step.py
msgid ""
"Distance between power samples along scan line. Lower values improve "
"accuracy, but increase output size"
msgstr ""
"Расстояние между точками замера мощности вдоль строки сканирования. Меньшие "
"значения повышают точность, но увеличивают размер файла"

#: laser_essentials/steps/raster_step.py
msgid "Dot Width Correction"
msgstr "Коррекция ширины точки"

#: laser_essentials/steps/raster_step.py
msgid ""
"Reduces engrave length at both ends to compensate for physical dot width"
msgstr ""
"Уменьшает длину гравировки с обоих концов, компенсируя физическую ширину "
"точки"

#: laser_essentials/steps/raster_step.py
msgid "Bidirectional Scan Offset"
msgstr "Смещение двунаправленного сканирования"

#: laser_essentials/steps/raster_step.py
msgid ""
"Corrects X misalignment between left-to-right and right-to-left raster "
"passes"
msgstr ""
"Исправляет несовпадение по X между проходами растра слева-направо и справа-"
"налево"

#: laser_essentials/steps/raster_step.py
msgid "Number of Depth Levels"
msgstr "Количество уровней глубины"

#: laser_essentials/steps/raster_step.py
msgid "Z Step-Down per Level"
msgstr "Шаг понижения по Z на уровень"

#: laser_essentials/steps/raster_step.py
msgid "Rotate Angle Per Pass"
msgstr "Угол поворота за проход"

#: laser_essentials/steps/raster_step.py
msgid "Degrees to rotate each successive pass"
msgstr "Угол поворота каждого следующего проходa, в градусах"

#: laser_essentials/steps/raster_step.py
msgid "Auto Levels"
msgstr "Автоуровни"

#: laser_essentials/steps/raster_step.py
msgid "Automatically adjust black/white points"
msgstr "Автоматически подстраивает точки чёрного/белого"

#: laser_essentials/steps/raster_step.py
msgid "White Point"
msgstr "Точка белого"

#: laser_essentials/steps/raster_step.py
msgid "Min Power"
msgstr "Мин. мощность"

#: laser_essentials/steps/raster_step.py
msgid "Max Power"
msgstr "Макс. мощность"

#: laser_essentials/steps/raster_step.py
msgid "Power Levels"
msgstr "Уровни мощности"

#: laser_essentials/steps/raster_step.py
msgid "Number of discrete power steps (lower = fewer moves)"
msgstr "Количество дискретных уровней мощности (меньше — меньше перемещений)"

#: laser_essentials/steps/raster_step.py
#, python-brace-format
msgid "The {mode} depth mode is not supported by this machine's driver."
msgstr "Режим глубины {mode} не поддерживается драйвером этого станка."

#: laser_essentials/steps/contour_step.py
msgid "Contour"
msgstr "Контур"

#: laser_essentials/steps/contour_step.py
msgid ""
"Shifts the cut path inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"Смещает путь резки внутрь/наружу в соответствии со стороной резки (не "
"действует при «По центру линии»). По умолчанию равно компенсации ширины реза"
" для головки"

#: laser_essentials/steps/contour_step.py
msgid "Cut Order"
msgstr "Порядок резки"

#: laser_essentials/steps/contour_step.py
msgid "Processing order for nested paths"
msgstr "Порядок обработки вложенных контуров"

#: laser_essentials/steps/contour_step.py
msgid "Remove Inner Paths"
msgstr "Удалять внутренние контуры"

#: laser_essentials/steps/contour_step.py
msgid "If enabled, only trace the outer outline of shapes"
msgstr "Если включено, обводится только внешний контур фигур"

#: laser_essentials/steps/contour_step.py
msgid "Overcut"
msgstr "Перерез"

#: laser_essentials/steps/contour_step.py
msgid ""
"Extend closed contours past their start point so the cut overlaps itself"
msgstr ""
"Продлевает замкнутые контуры за начальную точку, чтобы рез перекрывал сам "
"себя"

#: laser_essentials/steps/contour_step.py
msgid "Rescan Content"
msgstr "Повторное сканирование содержимого"

#: laser_essentials/steps/contour_step.py
msgid "Ignore source geometry and re-trace within the workpiece"
msgstr ""
"Игнорирует исходную геометрию и повторно обводит контур в пределах заготовки"

#: laser_essentials/steps/contour_step.py
msgid "Brightness level (0.0-1.0) to define edges"
msgstr "Уровень яркости (0,0–1,0) для определения границ"

#: laser_essentials/steps/material_test.py
#: laser_essentials/commands/material_test_cmd.py
msgid "Material Test Grid"
msgstr "Тестовая сетка материала"

#: laser_essentials/steps/material_test.py
msgid "Test Type"
msgstr "Тип теста"

#: laser_essentials/steps/material_test.py
msgid "Cut: outlines; Engrave: fills with raster lines"
msgstr "«Резка»: контуры; «Гравировка»: заливка растровыми линиями"

#: laser_essentials/steps/material_test.py
msgid "Grid Mode"
